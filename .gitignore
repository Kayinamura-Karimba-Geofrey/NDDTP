# Dependencies — installed via npm, never committed (lockfiles ARE committed)
node_modules/
.npm/
npm-debug.log*
yarn-error.log*

# Build output
dist/
build/
coverage/
.turbo/

# Environment files — commit only *.env.example
.env
.env.*
!.env.example

# Logs
logs/
*.log

# OS / tool clutter
.DS_Store
Thumbs.db
.freebuff/

# Security & hardening: block script droppers and private reports
*.bat
*.cmd
*.ps1
*.vbs
malware
*.tsbuildinfo
