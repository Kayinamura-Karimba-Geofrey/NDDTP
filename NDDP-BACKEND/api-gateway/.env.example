GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
API_PREFIX=api/v1
SERVICE_PREFIX=api/svc
SERVICE_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4200
REQUEST_TIMEOUT_MS=30000
